{
  "name": "keboola-data-app",
  "version": "0.1.0",
  "private": true,
  "description": "Keboola Python/JS data-app scaffold (React + Vite + Tailwind + Express)",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server/index.js",
    "dev:vite": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "dev:api": "tsx watch server/index.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.2",
    "express": "^4.19.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vite": "^6.4.3"
  }
}
