{
  "name": "keboola-data-app",
  "version": "0.1.0",
  "private": true,
  "description": "Keboola Python/JS data-app scaffold (React + Vite + Tailwind + Express)",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server/index.js",
    "dev:vite": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "dev:api": "tsx watch server/index.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "express": "^5.2.1",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
