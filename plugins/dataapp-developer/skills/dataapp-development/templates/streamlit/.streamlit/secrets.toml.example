# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit secrets.toml. .gitignore should exclude it.
#
# All three below are required for the Query Service path used by data_loader.py.
# See `references/storage-access.md` §Getting the env vars for local
# development in the dataapp-development skill for where to find each.
#
# KBC_TOKEN MUST be project-wide. Narrow-scoped (single-bucket / single-table)
# tokens are rejected by the Query Service with auth errors. Use either your
# user's master token (Settings → API Tokens → Refresh, or the Keboola Dev
# Tools Chrome extension) or a dedicated Storage API token with Full Access
# to all buckets and components.

KBC_URL = "https://connection.us-east4.gcp.keboola.com"
KBC_TOKEN = "your-project-wide-storage-api-token"
WORKSPACE_ID = "12345"

# Optional: if unset, derived from KBC_URL by swapping `connection.` → `query.`
# QUERY_SERVICE_URL = "https://query.us-east4.gcp.keboola.com"

# Optional: which branch's tables to read. If unset, "default" is used — the
# production branch, which is what you want. Set a numeric branch ID only when
# the app has to read a development branch's tables (branched storage).
# BRANCH_ID = "510379"
