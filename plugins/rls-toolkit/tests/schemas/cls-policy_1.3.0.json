{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "cls-policy",
 "type": "object",
 "additionalProperties": false,
 "version": "1.3.0",
 "required": [
  "table",
  "rules"
 ],
 "properties": {
  "table": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.\\-]+\\.[A-Za-z0-9_\\-]+$",
   "x-filterable": true
  },
  "dialect": {
   "type": "string",
   "enum": [
    "snowflake",
    "bigquery"
   ],
   "x-filterable": true,
   "x-filter-match-absent": true
  },
  "rules": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "visible_columns"
    ],
    "oneOf": [
     {
      "required": [
       "subjects"
      ]
     },
     {
      "required": [
       "groups"
      ]
     },
     {
      "required": [
       "attributes"
      ]
     }
    ],
    "properties": {
     "subjects": {
      "type": "array",
      "items": {
       "anyOf": [
        {
         "const": "*"
        },
        {
         "type": "string",
         "pattern": "^[^|\\s]+\\|\\S.*$",
         "maxLength": 1024
        }
       ]
      },
      "minItems": 1,
      "if": {
       "contains": {
        "const": "*"
       }
      },
      "then": {
       "maxItems": 1
      }
     },
     "groups": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1,
      "if": {
       "contains": {
        "const": "*"
       }
      },
      "then": {
       "maxItems": 1
      }
     },
     "visible_columns": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_]+$"
      },
      "minItems": 1
     },
     "attributes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
       "pattern": "^[A-Za-z0-9_.:/-]{1,128}$",
       "not": {
        "pattern": "^(?:[Ss][Uu][Bb]|[Ee][Mm][Aa][Ii][Ll]|[Ee][Mm][Aa][Ii][Ll]_[Vv][Ee][Rr][Ii][Ff][Ii][Ee][Dd]|[Gg][Rr][Oo][Uu][Pp][Ss]|[Rr][Oo][Ll][Ee][Ss]|[Ii][Ss][Ss]|[Aa][Uu][Dd]|[Ee][Xx][Pp]|[Ii][Aa][Tt]|[Nn][Bb][Ff]|[Nn][Oo][Nn][Cc][Ee]|[Jj][Tt][Ii]|[Ss][Ii][Dd]|[Ii][Dd][Pp]|[Kk][Bb][Cc]|[Aa][Zz][Pp]|[Aa][Cc][Rr]|[Aa][Mm][Rr]|[Aa][Uu][Tt][Hh]_[Tt][Ii][Mm][Ee]|[Aa][Tt]_[Hh][Aa][Ss][Hh]|[Cc]_[Hh][Aa][Ss][Hh]|[Aa][Tt][Tt][Rr][Ss])$"
       }
      },
      "additionalProperties": {
       "type": "array",
       "minItems": 1,
       "maxItems": 32,
       "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$",
        "not": {
         "const": "*"
        }
       }
      }
     },
     "issuers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 1024,
       "pattern": "^[^|\\s\\x00-\\x1f\\x7f]+$",
       "not": {
        "const": "*"
       }
      }
     }
    },
    "if": {
     "required": [
      "attributes"
     ]
    },
    "then": {
     "required": [
      "issuers"
     ]
    },
    "else": {
     "not": {
      "required": [
       "issuers"
      ]
     }
    }
   }
  }
 }
}
