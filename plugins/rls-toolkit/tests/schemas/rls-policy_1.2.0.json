{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "rls-policy",
 "type": "object",
 "additionalProperties": false,
 "version": "1.2.0",
 "required": [
  "table",
  "rules"
 ],
 "properties": {
  "table": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.\\-]+\\.[A-Za-z0-9_\\-]+$",
   "x-filterable": true
  },
  "dialect": {
   "type": "string",
   "enum": [
    "snowflake",
    "bigquery"
   ],
   "x-filterable": true,
   "x-filter-match-absent": true
  },
  "rules": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "condition"
    ],
    "oneOf": [
     {
      "required": [
       "subjects"
      ]
     },
     {
      "required": [
       "groups"
      ]
     }
    ],
    "properties": {
     "subjects": {
      "type": "array",
      "items": {
       "anyOf": [
        {
         "const": "*"
        },
        {
         "type": "string",
         "pattern": "^[^|\\s]+\\|\\S.*$",
         "maxLength": 1024
        }
       ]
      },
      "minItems": 1,
      "if": {
       "contains": {
        "const": "*"
       }
      },
      "then": {
       "maxItems": 1
      }
     },
     "groups": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1,
      "if": {
       "contains": {
        "const": "*"
       }
      },
      "then": {
       "maxItems": 1
      }
     },
     "condition": {
      "$ref": "#/$defs/condition"
     }
    }
   }
  },
  "default": {
   "$ref": "#/$defs/condition"
  }
 },
 "$defs": {
  "condition": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "true"
     ],
     "properties": {
      "true": {
       "const": true
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "false"
     ],
     "properties": {
      "false": {
       "const": true
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "and"
     ],
     "properties": {
      "and": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/condition"
       },
       "minItems": 2
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "or"
     ],
     "properties": {
      "or": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/condition"
       },
       "minItems": 2
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "column",
      "op",
      "value"
     ],
     "properties": {
      "column": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_]+$"
      },
      "op": {
       "enum": [
        "eq",
        "ne",
        "gt",
        "gte",
        "lt",
        "lte"
       ]
      },
      "value": {
       "anyOf": [
        {
         "not": {
          "type": "object",
          "required": [
           "$identity"
          ]
         }
        },
        {
         "$ref": "#/$defs/identityEmail"
        }
       ]
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "column",
      "op",
      "values"
     ],
     "properties": {
      "column": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_]+$"
      },
      "op": {
       "enum": [
        "in",
        "not_in"
       ]
      },
      "values": {
       "oneOf": [
        {
         "type": "array",
         "minItems": 1
        },
        {
         "$ref": "#/$defs/identityGroups"
        }
       ]
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "column",
      "op"
     ],
     "properties": {
      "column": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_]+$"
      },
      "op": {
       "enum": [
        "is_null",
        "is_not_null"
       ]
      }
     }
    }
   ]
  },
  "identityEmail": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "$identity"
   ],
   "properties": {
    "$identity": {
     "const": "email"
    }
   }
  },
  "identityGroups": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "$identity"
   ],
   "properties": {
    "$identity": {
     "const": "groups"
    }
   }
  }
 }
}